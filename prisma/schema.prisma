generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id              String   @id @default(cuid())
  name                String
  medicalRecordNumber String?
  gender              String?
  birthDate           DateTime?
  phone               String?
  email           String?
  lineId          String?
  address         String?
  occupation      String?
  referralSource  String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultations   Consultation[]
  labTests        LabTest[]
  prescriptions   Prescription[]
  tasks           Task[]
  lineTrackings   LineTracking[]
  doctorNotes     DoctorNote[]
  healthPlans     HealthPlan[]
  checklist       ClientChecklist[]
  riskLevel       String?
  cycles          VisitCycle[]

  @@index([name])
}

model VisitCycle {
  id        String           @id @default(cuid())
  clientId  String
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String
  status    String           @default("active")
  startDate DateTime         @default(now())
  endDate   DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  steps     VisitCycleStep[]

  @@index([clientId])
}

model VisitCycleStep {
  id          String     @id @default(cuid())
  cycleId     String
  cycle       VisitCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  label       String
  sortOrder   Int        @default(0)
  isCompleted Boolean    @default(false)
  completedAt DateTime?
  note        String?
  createdAt   DateTime   @default(now())

  @@index([cycleId])
}

model ClientChecklist {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([clientId, label])
  @@index([clientId])
}

model Consultation {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  visitType      String?
  chiefComplaint String?
  content        String?
  doctorAdvice   String?
  nextSteps      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LabTest {
  id                   String    @id @default(cuid())
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  testDate             DateTime?
  testType             String
  status               String    @default("scheduled")
  reportUrl            String?
  findings             String?
  doctorInterpretation String?
  staffExplanation     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Prescription {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  items       String
  totalDays   Int?
  runOutDate  DateTime?
  status      String   @default("active")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime?
  priority    String   @default("medium")
  status      String   @default("pending")
  assignedTo  String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LineTracking {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  content         String
  response        String?
  followUpNeeded  Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model DoctorNote {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date         DateTime  @default(now())
  diagnosis    String?
  treatment    String?
  prescription String?
  notes        String?
  nextVisit    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model HealthPlan {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  startDate DateTime  @default(now())
  endDate   DateTime?
  goals     String?
  actions   String?
  status    String    @default("active")
  progress  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PlanTemplate {
  id          String             @id @default(cuid())
  name        String
  description String?
  tasks       PlanTemplateTask[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PlanTemplateTask {
  id            String       @id @default(cuid())
  templateId    String
  template      PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  phase         String
  name          String
  orderIndex    Int          @default(0)
  durationHours Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([templateId])
}

model OptionConfig {
  id         String   @id @default(cuid())
  category   String
  label      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([category])
}
